generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Zone {
  Centro
  Norte
  Sur
  Este
}

enum PlanType {
  BASE
  PRO
}

enum BillingCycle {
  MONTHLY
  ANNUAL_10X12
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE_DEMO
}

enum TaxRegime {
  GENERAL
  RTS
}

enum UserRole {
  ADMIN
  KITCHEN
}

enum MovementType {
  PURCHASE
  SALE_DEDUCTION
  WASTE
  ADJUSTMENT
}

enum SaleSource {
  MANUAL_POS
  EXTERNAL_POS
}

enum WasteReason {
  EXPIRATION
  COLD_SPOILAGE
  PREP_ERROR
  PORTION_ERROR
  THEFT_LOSS
}

enum PurchaseOrderStatus {
  DRAFT_OFFLINE
  SENT_WHATSAPP
  RECEIVED
}

model Restaurant {
  id                 String             @id @default(cuid())
  name               String
  zone               Zone               @default(Centro)
  plan               PlanType           @default(BASE)
  billingCycle       BillingCycle       @default(MONTHLY)
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  taxRegime          TaxRegime          @default(GENERAL)
  isAseracMember     Boolean            @default(false)
  createdAt          DateTime           @default(now())

  users          User[]
  suppliers      Supplier[]
  ingredients    Ingredient[]
  recipes        Recipe[]
  sales          SaleRecord[]
  wastes         WasteRecord[]
  purchaseOrders PurchaseOrder[]
}

model User {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(KITCHEN)
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model Supplier {
  id            String  @id @default(cuid())
  restaurantId  String
  name          String
  category      String
  whatsappPhone String
  notes         String?

  restaurant         Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  defaultIngredients Ingredient[]         @relation("DefaultSupplier")
  ingredientLinks    IngredientSupplier[]
  purchaseOrders     PurchaseOrder[]
}

model Ingredient {
  id                String   @id @default(cuid())
  restaurantId      String
  name              String
  category          String
  location          String
  unit              String
  currentStock      Decimal  @db.Decimal(12, 3)
  minStock          Decimal  @db.Decimal(12, 3)
  optimalStock      Decimal  @db.Decimal(12, 3)
  unitCostBs        Decimal  @db.Decimal(12, 2)
  defaultSupplierId String
  updatedAt         DateTime @updatedAt

  restaurant         Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  defaultSupplier    Supplier             @relation("DefaultSupplier", fields: [defaultSupplierId], references: [id])
  supplierLinks      IngredientSupplier[]
  movements          InventoryMovement[]
  recipeIngredients  RecipeIngredient[]
  wasteRecords       WasteRecord[]
}

model IngredientSupplier {
  id           String @id @default(cuid())
  ingredientId String
  supplierId   String

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  supplier   Supplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([ingredientId, supplierId])
}

model InventoryMovement {
  id               String       @id @default(cuid())
  ingredientId     String
  type             MovementType
  quantityDelta    Decimal      @db.Decimal(12, 3)
  costImpactBs     Decimal      @db.Decimal(12, 2)
  referenceId      String?
  clientMutationId String       @unique
  createdAt        DateTime     @default(now())

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
}

model Recipe {
  id           String  @id @default(cuid())
  restaurantId String
  name         String
  category     String
  salePriceBs  Decimal @db.Decimal(12, 2)
  isActive     Boolean @default(true)

  restaurant  Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  ingredients RecipeIngredient[]
  sales       SaleRecord[]
}

model RecipeIngredient {
  id               String  @id @default(cuid())
  recipeId         String
  ingredientId     String
  quantityRequired Decimal @db.Decimal(12, 3)

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([recipeId, ingredientId])
}

model SaleRecord {
  id                    String     @id @default(cuid())
  restaurantId          String
  recipeId              String
  quantitySold          Int
  totalRevenueBs        Decimal    @db.Decimal(12, 2)
  totalIngredientCostBs Decimal    @db.Decimal(12, 2)
  source                SaleSource @default(MANUAL_POS)
  clientMutationId      String?    @unique
  createdAt             DateTime   @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model WasteRecord {
  id               String      @id @default(cuid())
  restaurantId     String
  ingredientId     String
  quantityLost     Decimal     @db.Decimal(12, 3)
  reason           WasteReason
  monetaryLossBs   Decimal     @db.Decimal(12, 2)
  notes            String?
  clientMutationId String?     @unique
  createdAt        DateTime    @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
}

model PurchaseOrder {
  id               String              @id @default(cuid())
  restaurantId     String
  supplierId       String
  status           PurchaseOrderStatus @default(DRAFT_OFFLINE)
  whatsappMessage  String
  estimatedTotalBs Decimal             @db.Decimal(12, 2)
  itemsJson        Json
  clientMutationId String?             @unique
  createdAt        DateTime            @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  supplier   Supplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}
